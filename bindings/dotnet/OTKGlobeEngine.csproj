<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>OTKGlobeEngine</AssemblyName>
    <RootNamespace>OTKGlobeEngine</RootNamespace>
    <PackageId>OTKGlobeEngine</PackageId>
    <Version>0.1.4</Version>
    <Authors>OTKGlobeEngine</Authors>
    <Description>.NET bindings for OTKGlobeEngine, a cross-platform globe map engine for TAK-style applications</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/grangedevgroup-code/OTKGlobeEngine</PackageProjectUrl>
    <RepositoryUrl>https://github.com/grangedevgroup-code/OTKGlobeEngine</RepositoryUrl>
    <PackageTags>map;gis;globe;tak;milstd2525;3dtiles;offline</PackageTags>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup Condition="Exists('runtimes')">
    <None Include="runtimes/**" Pack="true" PackagePath="runtimes/" />
  </ItemGroup>

</Project>
